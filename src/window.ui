<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_About Drafting</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>

  <template class="DraftingWindow" parent="AdwApplicationWindow">
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <property name="title">Drafting</property>

    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>

        <!-- 1. ส่วน Tab Bar (จะแสดงด้านบนสุด) -->
        <child>
          <object class="AdwTabBar" id="tab_bar">
            <property name="view">tab_view</property>
          </object>
        </child>

        <!-- 2. ส่วน Overlay ที่ห่อหุ้ม Canvas และปุ่มลอยทั้งหมด -->
        <child>
          <object class="GtkOverlay">
            <property name="vexpand">true</property>

            <!-- Canvas หลัก (AdwTabView) -->
            <child>
              <object class="AdwTabView" id="tab_view">
                <property name="vexpand">true</property>
              </object>
            </child>

            <!-- Window Controls มุมขวาบน -->
            <child type="overlay">
              <object class="GtkWindowHandle">
                <property name="halign">end</property>
                <property name="valign">start</property>
                <property name="margin-end">12</property>
                <property name="margin-top">8</property>
                <style>
                  <class name="osd"/>
                  <class name="toolbar"/>
                  <class name="drafting-floating"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <child>
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkWindowControls">
                        <property name="side">end</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Top Dock มุมซ้ายบน -->
            <child type="overlay">
              <object class="GtkBox">
                <property name="halign">start</property>
                <property name="valign">start</property>
                <property name="margin-start">12</property>
                <property name="margin-top">8</property>
                <property name="spacing">6</property>
                <style>
                  <class name="osd"/>
                  <class name="toolbar"/>
                  <class name="drafting-floating"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <style><class name="linked"/></style>
                    <child>
                      <object class="GtkButton" id="btn_new">
                        <property name="icon-name">plus-large-square-outline-symbolic</property>
                        <property name="tooltip-text">New</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_open">
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="tooltip-text">Open (Ctrl+O)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_save">
                        <property name="icon-name">arrow-pointing-at-line-down-symbolic</property>
                        <property name="tooltip-text">Save (Ctrl+S)</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <style><class name="linked"/></style>
                    <child>
                      <object class="GtkButton" id="btn_undo">
                        <property name="icon-name">arrow-hook-left-horizontal2-symbolic</property>
                        <property name="tooltip-text">Undo (Ctrl+Z)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_redo">
                        <property name="icon-name">arrow-turn-right-horizontal2-symbolic</property>
                        <property name="tooltip-text">Redo</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Left Dock -->
            <child type="overlay">
              <object class="GtkBox">
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="margin-start">12</property>
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <style>
                  <class name="osd"/>
                  <class name="toolbar"/>
                  <class name="drafting-floating"/>
                </style>
                <child>
                  <object class="GtkButton" id="btn_select">
                    <property name="icon-name">dot-node-pointer-left-symbolic</property>
                    <property name="tooltip-text">Select (S, Esc)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_line">
                    <property name="icon-name">draw-line-symbolic</property>
                    <property name="tooltip-text">Line (L)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_circle">
                    <property name="icon-name">draw-circle-symbolic</property>
                    <property name="tooltip-text">Circle (C)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_arc">
                    <property name="icon-name">draw-arc-symbolic</property>
                    <property name="tooltip-text">Arc (A, 3-point)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_polyline">
                    <property name="icon-name">draw-polyline-symbolic</property>
                    <property name="tooltip-text">Polyline (P, Enter to finish)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_dimension">
                    <property name="icon-name">ruler-outline-horizontal-symbolic</property>
                    <property name="tooltip-text">Dimension (D)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style><class name="linked"/></style>
                    <child>
                      <object class="GtkToggleButton" id="btn_snap">
                        <property name="icon-name">magnet-symbolic</property>
                        <property name="tooltip-text">Snap (F9)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="btn_snap_menu">
                        <property name="icon-name">pan-end-symbolic</property>
                        <property name="tooltip-text">Object snap settings</property>
                        <style><class name="drafting-expander"/></style>
                    </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="btn_auto_pan">
                    <property name="icon-name">four-arrows-pointing-outward-symbolic</property>
                    <property name="tooltip-text">Auto-pan at window edges</property>
                    <property name="active">true</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Snap Settings Dock -->
            <child type="overlay">
              <object class="GtkRevealer">
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="margin-start">72</property>
                <property name="transition-type">slide-right</property>
                <property name="transition-duration">250</property>
                <property name="reveal-child" bind-source="btn_snap_menu" bind-property="active" bind-flags="sync-create"/>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <style>
                      <class name="osd"/>
                      <class name="toolbar"/>
                      <class name="drafting-floating"/>
                    </style>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Object Snap</property>
                        <property name="halign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator"/>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="chk_snap_endpoint">
                        <property name="label">Endpoint</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="chk_snap_midpoint">
                        <property name="label">Midpoint</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="chk_snap_center">
                        <property name="label">Center</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="chk_snap_quadrant">
                        <property name="label">Quadrant</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="chk_snap_intersection">
                        <property name="label">Intersection</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Command Bar -->
            <child type="overlay">
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="valign">end</property>
                <property name="margin-bottom">18</property>
                <property name="spacing">8</property>
                <style>
                  <class name="osd"/>
                  <class name="toolbar"/>
                  <class name="drafting-floating"/>
                </style>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Command :</property>
                    <property name="margin-start">12</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="cmd_entry">
                    <property name="width-request">350</property>
                    <property name="placeholder-text">Type a command...</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Right Dock -->
            <child type="overlay">
              <object class="GtkStack" id="right_dock">
                <property name="halign">end</property>
                <property name="valign">center</property>
                <property name="hhomogeneous">false</property>
                <property name="vhomogeneous">false</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">150</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">default</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-end">12</property>
                        <style>
                          <class name="osd"/>
                          <class name="toolbar"/>
                          <class name="drafting-floating"/>
                        </style>
                        <child>
                          <object class="GtkButton" id="btn_array">
                            <property name="icon-name">grid-filled-symbolic</property>
                            <property name="tooltip-text">Array</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_offset">
                            <property name="icon-name">outline-offset-symbolic</property>
                            <property name="tooltip-text">Offset (O, or type: of 10)</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">offset_settings</property>
                    <property name="child">
                      <object class="GtkRevealer" id="revealer_offset_ui">
                        <property name="margin-end">12</property>
                        <property name="transition-type">slide-left</property>
                        <property name="transition-duration">300</property>
                        <property name="reveal-child">false</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <style>
                              <class name="osd"/>
                              <class name="toolbar"/>
                              <class name="drafting-floating"/>
                            </style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Offset</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator"/>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Distance :</property>
                                    <property name="halign">start</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="spin_offset_dist">
                                    <property name="width-request">110</property>
                                    <property name="digits">3</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0.001</property>
                                        <property name="upper">100000</property>
                                        <property name="value">10</property>
                                        <property name="step-increment">1</property>
                                        <property name="page-increment">10</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkButton" id="btn_offset_done">
                                    <property name="label">Done</property>
                                    <property name="hexpand">true</property>
                                    <property name="tooltip-text">Exit Offset (Esc)</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="drafting-apply-array"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="btn_offset_cancel">
                                    <property name="icon-name">window-close-symbolic</property>
                                    <property name="tooltip-text">Cancel and deselect</property>
                                    <style><class name="destructive-action"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">array_settings</property>
                    <property name="child">
                      <object class="GtkRevealer" id="revealer_array_ui">
                        <property name="margin-end">12</property>
                        <property name="transition-type">slide-left</property>
                        <property name="transition-duration">300</property>
                        <property name="reveal-child">false</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <style>
                              <class name="osd"/>
                              <class name="toolbar"/>
                              <class name="drafting-floating"/>
                            </style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Rectangular Array</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator"/>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="column-spacing">10</property>
                                <property name="row-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Rows :</property>
                                    <property name="halign">start</property>
                                    <layout><property name="column">0</property><property name="row">0</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="spin_rows">
                                    <property name="width-request">130</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100</property>
                                        <property name="value">1</property>
                                        <property name="step-increment">1</property>
                                      </object>
                                    </property>
                                    <layout><property name="column">1</property><property name="row">0</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Columns :</property>
                                    <property name="halign">start</property>
                                    <layout><property name="column">0</property><property name="row">1</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="spin_cols">
                                    <property name="width-request">130</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">1</property>
                                        <property name="upper">100</property>
                                        <property name="value">1</property>
                                        <property name="step-increment">1</property>
                                      </object>
                                    </property>
                                    <layout><property name="column">1</property><property name="row">1</property></layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator"/>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="column-spacing">10</property>
                                <property name="row-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Spacing X :</property>
                                    <layout><property name="column">0</property><property name="row">0</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="spin_spacing_x">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">-10000</property>
                                        <property name="upper">10000</property>
                                        <property name="value">100</property>
                                        <property name="step-increment">10</property>
                                      </object>
                                    </property>
                                    <layout><property name="column">1</property><property name="row">0</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Spacing Y :</property>
                                    <layout><property name="column">0</property><property name="row">1</property></layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="spin_spacing_y">
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">-10000</property>
                                        <property name="upper">10000</property>
                                        <property name="value">100</property>
                                        <property name="step-increment">10</property>
                                      </object>
                                    </property>
                                    <layout><property name="column">1</property><property name="row">1</property></layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkButton" id="btn_apply_array">
                                    <property name="label">Apply Array</property>
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="drafting-apply-array"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="btn_cancel_array">
                                    <property name="icon-name">window-close-symbolic</property>
                                    <style><class name="destructive-action"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
